--========================================================--
-- LOOP PRINCIPAL
--========================================================--

local function startLoop()

	table.insert(
		Connections,
		RunService.RenderStepped:Connect(
			function(Delta)

				if not Character
					or not Humanoid
					or not Root then
					return
				end

				if Humanoid.Health <= 0 then
					return
				end

				Camera =
					workspace.CurrentCamera

				local Velocity =
					Root.AssemblyLinearVelocity

				local Flat =
					Vector3.new(
						Velocity.X,
						0,
						Velocity.Z
					)

				CurrentSpeed =
					Flat.Magnitude

				--================================================--
				-- TURBO
				--================================================--

				if TurboActive then

					if CurrentSpeed < 3 then

						stopTurbo()

					else

						TurboCharge =
							TurboCharge -
							Delta/TURBO_DURATION

						if TurboCharge <= 0 then

							TurboCharge = 0
							TurboReady = false

							stopTurbo()
						end
					end

				else

					rechargeTurbo(Delta)
				end

				-- 🔥 CHAMA DO TURBO
				updateTurboFlames(Delta)

				--================================================--
				-- ACELERADOR
				--================================================--

				if CarEnabled
					and not TurboActive then

					local TargetSpeed =
						CAR_MAX_SPEED

					if ClockLimitEnabled
						and ClockSpeedLimit then

						TargetSpeed =
							math.min(
								TargetSpeed,
								ClockSpeedLimit
							)
					end

					if AcceleratorHeld then

						DriveSpeed =
							math.min(
								DriveSpeed +
								CAR_ACCELERATION *
								Delta,
								TargetSpeed
							)

						forceCarMovement(
							DriveSpeed,
							Delta
						)
					end

					--================================================--
					-- FREIO
					--================================================--

					if BrakeHeld then

						DriveSpeed =
							math.max(
								0,
								DriveSpeed -
								400 *
								Delta
							)

						local BrakeVelocity =
							Root.AssemblyLinearVelocity

						local BrakeFlat =
							Vector3.new(
								BrakeVelocity.X,
								0,
								BrakeVelocity.Z
							)

						local BrakeFactor =
							math.clamp(
								1 -
								Delta*9,
								0,
								1
							)

						local NewFlat =
							BrakeFlat *
							BrakeFactor

						Root.AssemblyLinearVelocity =
							Vector3.new(
								NewFlat.X,
								BrakeVelocity.Y,
								NewFlat.Z
							)
					end

					Humanoid.WalkSpeed =
						math.min(
							DriveSpeed,
							NORMAL_SPEED
						)
				end

				updateTurboMovement()
				updateReverseLights()
				updateSmoke()
				updateTireTrail()
				updateDashboard()
				updateChargeGui()

			end
		)
	)

end

