local function buttonPress(Button)

	local Scale =
		Button:FindFirstChild("ButtonScale")

	if not Scale then
		return
	end

	TweenService:Create(
		Scale,
		TweenInfo.new(
			0.055,
			Enum.EasingStyle.Quad
		),
		{
			Scale = 0.84
		}
	):Play()

	task.delay(0.065,function()

		if Scale and Scale.Parent then

			TweenService:Create(
				Scale,
				TweenInfo.new(
					0.12,
					Enum.EasingStyle.Back
				),
				{
					Scale = 1
				}
			):Play()

		end
	end)

end

local function createButton(
	Parent,
	Name,
	Text,
	Size
)

	local Button =
		Instance.new("TextButton")

	Button.Name = Name
	Button.Size =
		Size or
		UDim2.new(0,31,0,28)

	Button.BackgroundColor3 =
		Color3.fromRGB(
			245,
			245,
			245
		)

	Button.BackgroundTransparency = 0.15
	Button.BorderSizePixel = 0
	Button.Text = Text

	Button.TextColor3 =
		Color3.fromRGB(
			15,
			15,
			15
		)

	Button.Font = Enum.Font.SciFi
	Button.TextScaled = true
	Button.AutoButtonColor = false
	Button.Parent = Parent

	local Corner =
		Instance.new("UICorner")

	Corner.CornerRadius =
		UDim.new(0,9)

	Corner.Parent = Button

	local Stroke =
		Instance.new("UIStroke")

	Stroke.Color =
		Color3.fromRGB(
			255,
			255,
			255
		)

	Stroke.Thickness = 1.5
	Stroke.Parent = Button

	local Scale =
		Instance.new("UIScale")

	Scale.Name = "ButtonScale"
	Scale.Parent = Button

	table.insert(
		Connections,
		Button.Activated:Connect(
			function()
				buttonPress(Button)
			end
		)
	)

	return Button

end

local function setupHoldButton(
	Button,
	StartFunction,
	EndFunction
)

	table.insert(
		Connections,
		Button.InputBegan:Connect(
			function(Input)

				if
					Input.UserInputType ==
					Enum.UserInputType.MouseButton1
					or
					Input.UserInputType ==
					Enum.UserInputType.Touch
				then

					buttonPress(Button)

					StartFunction()

					Button.BackgroundTransparency =
						0.02
				end
			end
		)
	)

	table.insert(
		Connections,
		Button.InputEnded:Connect(
			function(Input)

				if
					Input.UserInputType ==
					Enum.UserInputType.MouseButton1
					or
					Input.UserInputType ==
					Enum.UserInputType.Touch
				then

					EndFunction()

					Button.BackgroundTransparency =
						0.15
				end
			end
		)
	)

end

