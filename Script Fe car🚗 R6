	end
end

--========================================================--
-- BOTÃO
--========================================================--

local function buttonPress(Button)

	local Scale =
		Button:FindFirstChild("ButtonScale")

	if not Scale then
		return
	end

	TweenService:Create(
		Scale,
		TweenInfo.new(
			0.055,
			Enum.EasingStyle.Quad
		),
		{
			Scale = 0.84
		}
	):Play()

	task.delay(0.065, function()

		if Scale and Scale.Parent then

			TweenService:Create(
				Scale,
				TweenInfo.new(
					0.12,
					Enum.EasingStyle.Back
				),
				{
					Scale = 1
				}
			):Play()

		end
	end)
end

