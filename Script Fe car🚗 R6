	disconnectAll()

	CarEnabled = true
	DriftEnabled = false
	LightEnabled = false
	ImpactEnabled = true

	TurboActive = false
	TurboCharge = 1
	TurboReady = true
	TurboFlameTimer = 0

	AcceleratorHeld = false
	BrakeHeld = false

	DriveSpeed =
		NORMAL_SPEED

	ClockLimitEnabled = false
	ClockSpeedLimit = nil

	CurrentSpeed = 0

	PreviousLeftWheel = nil
	PreviousRightWheel = nil

	getCharacter()
	setupCharacter()
	createGui()

	HeadLightLeft,
	HeadLightRight =
		createLights()

	createSmoke()
	createTurboSmoke()

	-- 🔥 NOVO
	createTurboFlames()

	connectButtons()
	connectImpact()
	startLoop()

	updateLights()
	updateChargeGui()
	updateGauge()

end

