local function getGear(Speed)

	if Speed < 2 then
		return "N"
	elseif Speed < 45 then
		return "1"
	elseif Speed < 100 then
		return "2"
	elseif Speed < 250 then
		return "3"
	elseif Speed < 500 then
		return "4"
	else
		return "5"
	end
end

local function updateDashboard()

	if not SpeedText then
		return
	end

	SpeedText.Text =
		string.format(
			"%03d",
			math.floor(
				math.clamp(
					CurrentSpeed,
					0,
					TURBO_SPEED
				) + 0.5
			)
		)

	GearText.Text =
		getGear(CurrentSpeed)

	if TurboActive then

		StatusText.Text = "TURBO"

	elseif DriftEnabled
		and CurrentSpeed >= DRIFT_MIN_SPEED
		and isSharpTurn() then

		StatusText.Text = "DRIFT"

	elseif CurrentSpeed > 5 then

		StatusText.Text = "DRIVE"

	else

		StatusText.Text = "IDLE"
	end
end

--========================================================--
-- 💥 IMPACTO
--========================================================--

local function connectImpact()

	if not Root then
		return
	end

	table.insert(
		Connections,
		Root.Touched:Connect(function(Hit)

			if not ImpactEnabled
				or not CarEnabled then
				return
			end

			if CurrentSpeed < IMPACT_MIN_SPEED then
				return
			end

			if tick() - LastImpact <
				IMPACT_COOLDOWN then
				return
			end

			local Model =
				Hit:FindFirstAncestorOfClass(
					"Model"
				)

			if not Model
				or Model == Character then
				return
			end

			local OtherHumanoid =
				Model:FindFirstChildOfClass(
					"Humanoid"
				)

			local OtherRoot =
				Model:FindFirstChild(
					"HumanoidRootPart"
				)

			if not OtherHumanoid
				or not OtherRoot then
				return
			end

			LastImpact = tick()

			local Velocity =
				Root.AssemblyLinearVelocity

			local Direction =
				Vector3.new(
					Velocity.X,
					0,
					Velocity.Z
				)

			if Direction.Magnitude < 1 then

				Direction =
					Root.CFrame.LookVector

				Direction =
					Vector3.new(
						Direction.X,
						0,
						Direction.Z
					)
			end

			if Direction.Magnitude < 0.01 then
				return
			end

			Direction =
				Direction.Unit

			local Push =
				Direction *
				IMPACT_FORCE *
				math.clamp(
					CurrentSpeed / 60,
					0.8,
					2
				)

			Push =
				Push +
				Vector3.new(
					0,
					IMPACT_UP_FORCE,
					0
				)

			pcall(function()

				OtherRoot:ApplyImpulse(
					Push *
					OtherRoot.AssemblyMass
				)

			end)
		end)
	)
end

