-- RASTRO DAS RODAS
--========================================================--

local function getGround(Position)

	local Params =
		RaycastParams.new()

	Params.FilterType =
		Enum.RaycastFilterType.Exclude

	Params.FilterDescendantsInstances = {
		Character
	}

	local Result =
		workspace:Raycast(
			Position +
			Vector3.new(0, 4, 0),

			Vector3.new(
				0,
				-15,
				0
			),

			Params
		)

	if Result then
		return Result.Position
	end

	return nil
end

local function createTrailSegment(From, To)

	if not From or not To then
		return
	end

	local Distance =
		(From - To).Magnitude

	if Distance < 0.03 then
		return
	end

	local Mark =
		Instance.new("Part")

	Mark.Name =
		"HenriqueTireTrail"

	Mark.Anchored = true
	Mark.CanCollide = false
	Mark.CanTouch = false
	Mark.CanQuery = false

	Mark.Material =
		Enum.Material.SmoothPlastic

	Mark.Color =
		Color3.fromRGB(
			12,
			12,
			12
		)

	Mark.Transparency = 0.08

	Mark.Size =
		Vector3.new(
			TIRE_MARK_WIDTH,
			0.035,
			Distance + 0.15
		)

	Mark.CFrame =
		CFrame.lookAt(
			(From + To) / 2 +
			Vector3.new(
				0,
				0.018,
				0
			),
			To
		)

	Mark.Parent = workspace

	TweenService:Create(
		Mark,
		TweenInfo.new(
			TIRE_MARK_LIFETIME,
			Enum.EasingStyle.Linear
		),
		{
			Transparency = 1
		}
	):Play()

	Debris:AddItem(
		Mark,
		TIRE_MARK_LIFETIME + 0.2
	)
end

local function updateTireTrail()

	if not Root then
		return
	end

	if not DriftEnabled then

		PreviousLeftWheel = nil
		PreviousRightWheel = nil

		return
	end

	if CurrentSpeed < DRIFT_MIN_SPEED then
		return
	end

	if not isSharpTurn() then

		PreviousLeftWheel = nil
		PreviousRightWheel = nil

		return
	end

	local Right =
		Root.CFrame.RightVector

	local Forward =
		Root.CFrame.LookVector

	local LeftWheel =
		Root.Position
		- Right * 1.15
		+ Forward * 0.7

	local RightWheel =
		Root.Position
		+ Right * 1.15
		+ Forward * 0.7

	local LeftGround =
		getGround(LeftWheel)

	local RightGround =
		getGround(RightWheel)

	if not LeftGround
		or not RightGround then
		return
	end

	if PreviousLeftWheel then

		if (
			LeftGround -
			PreviousLeftWheel
		).Magnitude < 6 then

			createTrailSegment(
				PreviousLeftWheel,
				LeftGround
			)
		end
	end

	if PreviousRightWheel then

		if (
			RightGround -
			PreviousRightWheel
		).Magnitude < 6 then

			createTrailSegment(
				PreviousRightWheel,
				RightGround
			)
		end
	end

	PreviousLeftWheel = LeftGround
	PreviousRightWheel = RightGround
end

