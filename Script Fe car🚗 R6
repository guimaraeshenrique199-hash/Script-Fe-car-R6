end

local function setupCharacter()

	Humanoid.WalkSpeed = NORMAL_SPEED
	Humanoid.JumpPower = 20
	Humanoid.AutoRotate = true
	Humanoid.UseJumpPower = true

	DriveSpeed = NORMAL_SPEED

	local Animate =
		Character:FindFirstChild("Animate")

	if Humanoid.RigType ==
		Enum.HumanoidRigType.R6 then

		Humanoid.HipHeight = -0.72

		if Animate then

			pcall(function()

				Animate.walk.WalkAnim.AnimationId =
					R6_ANIMATION

				Animate.run.RunAnim.AnimationId =
					R6_ANIMATION

				Animate.fall.FallAnim.AnimationId =
					R6_ANIMATION

				Animate.idle.Animation1.AnimationId =
					R6_ANIMATION

				Animate.idle.Animation2.AnimationId =
					R6_ANIMATION

				Animate.jump.JumpAnim.AnimationId =
					R6_ANIMATION

			end)
		end

	else

		Humanoid.HipHeight = 0.72

		if Animate then

			pcall(function()

				Animate.walk.WalkAnim.AnimationId =
					R15_ANIMATION

				Animate.run.RunAnim.AnimationId =
					R15_ANIMATION

				Animate.fall.FallAnim.AnimationId =
					R15_ANIMATION

				Animate.idle.Animation1.AnimationId =
					R15_ANIMATION

				Animate.idle.Animation2.AnimationId =
					R15_ANIMATION

				Animate.jump.JumpAnim.AnimationId =
					R15_ANIMATION

			end)
		end
	end

	for _,Object in ipairs(
		Character:GetDescendants()
	) do

		if Object:IsA("BasePart") then

			pcall(function()

				Object.CustomPhysicalProperties =
					PhysicalProperties.new(
						0.04,
						0,
						0,
						1,
						1
					)

			end)
		end
	end

end

