local function getGear(Speed)

	if Speed < 2 then
		return "N"
	elseif Speed < 45 then
		return "1"
	elseif Speed < 100 then
		return "2"
	elseif Speed < 250 then
		return "3"
	elseif Speed < 500 then
		return "4"
	else
		return "5"
	end

end

local function updateDashboard()

	updateGauge()

	if GaugeGear then
		GaugeGear.Text =
			getGear(CurrentSpeed)
	end

	if GaugeStatus then

		if TurboActive then

			GaugeStatus.Text =
				"TURBO"

		elseif
			DriftEnabled
			and
			CurrentSpeed >=
			DRIFT_MIN_SPEED
			and
			isSharpTurn()
		then

			GaugeStatus.Text =
				"DRIFT"

		elseif CurrentSpeed > 5 then

			GaugeStatus.Text =
				"DRIVE"

		else

			GaugeStatus.Text =
				"IDLE"
		end
	end

end

