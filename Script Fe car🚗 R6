--========================================================--
-- LOOP
--========================================================--

local function startLoop()

	table.insert(
		Connections,
		RunService.RenderStepped:Connect(function(Delta)

			if not Character
				or not Humanoid
				or not Root then
				return
			end

			if Humanoid.Health <= 0 then
				return
			end

			Camera =
				workspace.CurrentCamera

			local Velocity =
				Root.AssemblyLinearVelocity

			local Flat =
				Vector3.new(
					Velocity.X,
					0,
					Velocity.Z
				)

			CurrentSpeed =
				Flat.Magnitude

			--================================================--
			-- TURBO
			--================================================--

			if TurboActive then

				if CurrentSpeed < 3 then

					stopTurbo()

				else

					TurboCharge =
						TurboCharge -
						Delta /
						TURBO_DURATION

					if TurboCharge <= 0 then

						TurboCharge = 0
						TurboReady = false

						stopTurbo()
					end
				end

			else

				rechargeTurbo(Delta)
			end

			--================================================--
			-- VELOCIDADE NORMAL
			--================================================--

			if CarEnabled
				and not TurboActive then

				if DriftEnabled then

					Humanoid.WalkSpeed =
						DRIFT_SPEED

				else

					Humanoid.WalkSpeed =
						NORMAL_SPEED
				end
			end

			--================================================--
			-- TURBO
			--================================================--

			updateTurboMovement()

			--================================================--
			-- RÉ
			--================================================--

			updateReverseLights()

			--================================================--
			-- EFEITOS
			--================================================--

			updateSmoke()
			updateTireTrail()
			updateDashboard()
			updateChargeGui()

		end)
	)
end

--========================================================--
-- ARRASTAR GUI
--========================================================--

local function enableDragging()

	local Dragging = false
	local DragStart
	local StartPosition

	table.insert(
		Connections,
		Dashboard.InputBegan:Connect(function(Input)

			if Input.UserInputType ==
				Enum.UserInputType.MouseButton1
				or Input.UserInputType ==
				Enum.UserInputType.Touch then

				Dragging = true
				DragStart = Input.Position
				StartPosition = Dashboard.Position
			end
		end)
	)

	table.insert(
		Connections,
		UserInputService.InputChanged:Connect(function(Input)

			if not Dragging then
				return
			end

			if Input.UserInputType ~=
				Enum.UserInputType.MouseMovement
				and Input.UserInputType ~=
				Enum.UserInputType.Touch then
				return
			end

			local Delta =
				Input.Position -
				DragStart

			local CameraNow =
				workspace.CurrentCamera

			if not CameraNow then
				return
			end

			local Viewport =
				CameraNow.ViewportSize

			local X =
				StartPosition.X.Offset +
				Delta.X

			local Y =
				StartPosition.Y.Offset +
				Delta.Y

			X =
				math.clamp(
					X,
					-Viewport.X / 2 + 140,
					Viewport.X / 2 - 140
				)

			Y =
				math.clamp(
					Y,
					-Viewport.Y + 125,
					-5
				)

			Dashboard.Position =
				UDim2.new(
					0.5,
					X,
					1,
					Y
				)
		end)
	)

	table.insert(
		Connections,
		UserInputService.InputEnded:Connect(function(Input)

			if Input.UserInputType ==
				Enum.UserInputType.MouseButton1
				or Input.UserInputType ==
				Enum.UserInputType.Touch then

				Dragging = false
			end
		end)
	)
end

