			Instance.new("Attachment")

		Attachment.Position = Position
		Attachment.Parent = Root

		local Light =
			Instance.new("SpotLight")

		Light.Brightness = 5
		Light.Range = 55
		Light.Angle = 55
		Light.Shadows = true
		Light.Enabled = false
		Light.Parent = Attachment

		return Light
	end

	local Left =
