				1.85
			)
		)

	return Left, Right
end

--========================================================--
-- 🔴 VISUAL DA RÉ
--========================================================--

local function setReverseVisual(Enabled)

	local Folder =
		Character
		and Character:FindFirstChild(
			"HenriqueCarLights"
		)

	if not Folder then
		return
	end

	local ReverseFolder =
		Folder:FindFirstChild(
			"ReverseLights"
		)

	if not ReverseFolder then
		return
	end

	for _, Object in ipairs(
		ReverseFolder:GetChildren()
	) do

		if Object:IsA("Part")
			and Object:GetAttribute(
				"ReverseLight"
			) then

			Object.Transparency =
				Enabled
				and 0.05
				or 1
		end
	end
end

--========================================================--
-- RÉ
--========================================================--

local function updateReverseLights()

	if not ReverseLeft
		or not ReverseRight
		or not Root then
		return
	end

	local Velocity =
		Root.AssemblyLinearVelocity

	local Horizontal =
		Vector3.new(
			Velocity.X,
			0,
			Velocity.Z
		)

	local Reversing = false

	if Horizontal.Magnitude > 4 then

		local Forward =
			Root.CFrame.LookVector

		local Dot =
			Horizontal.Unit:Dot(
				Forward
			)

		Reversing =
			Dot < -0.25
	end

	ReverseLeft.Enabled = Reversing
	ReverseRight.Enabled = Reversing

	setReverseVisual(Reversing)
end

