local function updateGauge()

	if not Needle
		or not NeedlePivot
		or not DigitalSpeed then
		return
	end

	local Speed =
		math.clamp(
			CurrentSpeed,
			0,
			CAR_MAX_SPEED
		)

	DigitalSpeed.Text =
		string.format(
			"%03d",
			math.floor(
				Speed + 0.5
			)
		)

	local Fraction

	if Speed >= CAR_MAX_SPEED then

		Fraction = 1

	else

		local CycleSpeed =
			Speed % 100

		Fraction =
			CycleSpeed / 100
	end

	local TargetRotation =
		135 +
		(Fraction * 270)

	local CurrentRotation =
		NeedlePivot.Rotation

	local Difference =
		TargetRotation -
		CurrentRotation

	while Difference > 180 do
		Difference -= 360
	end

	while Difference < -180 do
		Difference += 360
	end

	NeedlePivot.Rotation =
		CurrentRotation +
		Difference * 0.18

end

