local function createGaugeNumber(
	Parent,
	Number,
	Angle
)

	local Label =
		Instance.new("TextLabel")

	Label.AnchorPoint =
		Vector2.new(0.5,0.5)

	local Radius = 51

	local Radians =
		math.rad(
			Angle - 90
		)

	local X =
		math.cos(Radians) *
		Radius

	local Y =
		math.sin(Radians) *
		Radius

	Label.Position =
		UDim2.new(
			0.5,
			X,
			0.5,
			Y
		)

	Label.Size =
		UDim2.new(
			0,
			25,
			0,
			22
		)

	Label.BackgroundTransparency = 1
	Label.Text = tostring(Number)

	Label.Font =
		Enum.Font.SciFi

	Label.TextScaled = true

	Label.TextColor3 =
		Number >= 8
		and Color3.fromRGB(
			255,
			80,
			90
		)
		or Color3.fromRGB(
			225,
			250,
			255
		)

	Label.Parent = Parent

end

