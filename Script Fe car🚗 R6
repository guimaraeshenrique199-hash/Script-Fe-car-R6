-- ⚡ TURBO
--========================================================--

local function stopTurbo()

	TurboActive = false

	if Humanoid then

		Humanoid.WalkSpeed =
			DriftEnabled
			and DRIFT_SPEED
			or NORMAL_SPEED
	end

	if Camera then

		TweenService:Create(
			Camera,
			TweenInfo.new(
				0.35,
				Enum.EasingStyle.Quad
			),
			{
				FieldOfView = NORMAL_FOV
			}
		):Play()
	end

	updateSmoke()
end

local function startTurbo()

	if not TurboReady
		or not CarEnabled then
		return
	end

	if CurrentSpeed < 2 then
		return
	end

	TurboActive = true

	if Humanoid then
		Humanoid.WalkSpeed = TURBO_SPEED
	end

	if Camera then

		TweenService:Create(
			Camera,
			TweenInfo.new(
				0.12,
				Enum.EasingStyle.Quad
			),
			{
				FieldOfView = TURBO_FOV
			}
		):Play()
	end

	updateSmoke()
end

local function useTurbo()

	if TurboActive then
		return
	end

	if not TurboReady then
		return
	end

	startTurbo()
end

--========================================================--
-- MOVIMENTO DO TURBO
--========================================================--

local function updateTurboMovement()

	if not TurboActive
		or not Root
		or not Humanoid then
		return
	end

	local MoveDirection =
		Humanoid.MoveDirection

	if MoveDirection.Magnitude < 0.05 then

		stopTurbo()
		return
	end

	local Velocity =
		Root.AssemblyLinearVelocity

	local CurrentFlat =
		Vector3.new(
			Velocity.X,
			0,
			Velocity.Z
		)

	local Target =
		MoveDirection.Unit *
		TURBO_SPEED

	-- aceleração BEM mais suave
	local Alpha =
		math.clamp(
			TURBO_ACCELERATION *
			0.016 /
			math.max(
				TURBO_SPEED,
				1
			),
			0.018,
			0.06
		)

	local NewFlat =
		CurrentFlat:Lerp(
			Target,
			Alpha
		)

	Root.AssemblyLinearVelocity =
		Vector3.new(
			NewFlat.X,
			Velocity.Y,
			NewFlat.Z
		)
end

--========================================================--
-- RECARGA
--========================================================--

local function rechargeTurbo(Delta)

	if TurboActive then
		return
	end

	if TurboCharge >= 1 then

		TurboCharge = 1
		TurboReady = true

		updateChargeGui()
		return
	end

	TurboCharge =
		math.clamp(
			TurboCharge +
			Delta / TURBO_RECHARGE,
			0,
			1
		)

	if TurboCharge >= 1 then
		TurboReady = true
	end

	updateChargeGui()
end

