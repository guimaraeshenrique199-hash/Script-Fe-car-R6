local function stopTurbo()

	TurboActive = false
	TurboFlameTimer = 0

	if Humanoid then

		Humanoid.WalkSpeed =
			math.clamp(
				DriveSpeed,
				0,
				NORMAL_SPEED
			)
	end

	if Camera then

		TweenService:Create(
			Camera,
			TweenInfo.new(
				0.35,
				Enum.EasingStyle.Quad
			),
			{
				FieldOfView =
					NORMAL_FOV
			}
		):Play()
	end

	updateSmoke()

end

local function startTurbo()

	if not TurboReady
		or not CarEnabled then
		return
	end

	if CurrentSpeed < 2 then
		return
	end

	TurboActive = true
	TurboFlameTimer = 0

	if Humanoid then
		Humanoid.WalkSpeed =
			TURBO_SPEED
	end

	if Camera then

		TweenService:Create(
			Camera,
			TweenInfo.new(
				0.12,
				Enum.EasingStyle.Quad
			),
			{
				FieldOfView =
					TURBO_FOV
			}
		):Play()
	end

	updateSmoke()

end

local function useTurbo()

	if TurboActive then
		return
	end

	if not TurboReady then
		return
	end

	startTurbo()

end

local function updateTurboMovement()

	if not TurboActive
		or not Root
		or not Humanoid then
		return
	end

	local MoveDirection =
		Humanoid.MoveDirection

	if MoveDirection.Magnitude < 0.05 then

		stopTurbo()
		return
	end

	local Velocity =
		Root.AssemblyLinearVelocity

	local CurrentFlat =
		Vector3.new(
			Velocity.X,
			0,
			Velocity.Z
		)

	local Target =
		MoveDirection.Unit *
		TURBO_SPEED

	local Alpha =
		math.clamp(
			TURBO_ACCELERATION *
			0.016 /
			math.max(
				TURBO_SPEED,
				1
			),
			0.018,
			0.055
		)

	local NewFlat =
		CurrentFlat:Lerp(
			Target,
			Alpha
		)

	Root.AssemblyLinearVelocity =
		Vector3.new(
			NewFlat.X,
			Velocity.Y,
			NewFlat.Z
		)

end

local function rechargeTurbo(Delta)

	if TurboActive then
		return
	end

	if TurboCharge >= 1 then

		TurboCharge = 1
		TurboReady = true

		updateChargeGui()

		return
	end

	TurboCharge =
		math.clamp(
			TurboCharge +
			Delta/TURBO_RECHARGE,
			0,
			1
		)

	if TurboCharge >= 1 then
		TurboReady = true
	end

	updateChargeGui()

end

--========================================================--
-- MOVIMENTO DO CARRO
--========================================================--

local function forceCarMovement(
	TargetSpeed,
	Delta
)

	if not Root
		or not Humanoid then
		return
	end

	local MoveDirection =
		Humanoid.MoveDirection

	if MoveDirection.Magnitude < 0.05 then

		MoveDirection =
			Root.CFrame.LookVector
	end

	if MoveDirection.Magnitude < 0.05 then
		return
	end

	local Velocity =
		Root.AssemblyLinearVelocity

	local CurrentFlat =
		Vector3.new(
			Velocity.X,
			0,
			Velocity.Z
		)

	local Target =
		MoveDirection.Unit *
		TargetSpeed

	local Alpha =
		math.clamp(
			CAR_ACCELERATION *
			Delta /
			math.max(
				TargetSpeed,
				1
			),
			0.006,
			0.025
		)

	local NewFlat =
		CurrentFlat:Lerp(
			Target,
			Alpha
		)

	Root.AssemblyLinearVelocity =
		Vector3.new(
			NewFlat.X,
			Velocity.Y,
			NewFlat.Z
		)

end

