local function isSharpTurn()

	if not Root then
		return false
	end

	local Velocity =
		Root.AssemblyLinearVelocity

	local Flat =
		Vector3.new(
			Velocity.X,
			0,
			Velocity.Z
		)

	if Flat.Magnitude <
		DRIFT_MIN_SPEED then
		return false
	end

	local Side =
		Root.CFrame.RightVector

	return math.abs(
		Flat.Unit:Dot(Side)
	) > DRIFT_TURN

end

